###Kylin Linux Server 6.9 - os repo###

[ks6-os]
name = Kylin Linux Server 6.9 - Os
baseurl = https://update.cs2c.com.cn/NS/V6/V6.9/os/lic/base/$basearch/
gpgcheck = 0
sslverify = 0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-kylin
enabled = 1

[ks6-updates]
name = Kylin Linux Server 6.9 - Updates
baseurl = https://update.cs2c.com.cn/NS/V6/V6.9/os/lic/updates/$basearch/
gpgcheck = 0
sslverify = 0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-kylin
enabled = 1
